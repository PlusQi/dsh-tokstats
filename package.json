{
  "name": "dsh-tokstats",
  "version": "0.9.0",
  "description": "可能有用的 DSH token 用量插件，跨会话统计 token 都花在哪儿了：用量总览四项指标、上下文长度分布、近 12 周热力图与按周趋势，工作区与模型排行；另附有发送前 token 预告和输入草稿优化功能。",
  "type": "module",
  "main": "lib/index.js",
  "icon": "icon.svg",
  "author": "PlusQi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PlusQi/dsh-tokstats.git"
  },
  "homepage": "https://github.com/PlusQi/dsh-tokstats",
  "bugs": {
    "url": "https://github.com/PlusQi/dsh-tokstats/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "token",
    "usage",
    "analytics",
    "ui"
  ],
  "engines": {
    "dsh": "0.2.1-rc.3"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "guard": "node scripts/check-plugin-structure.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./tokprev": "./lib/index.js",
    "./promptopt": "./lib/index.js",
    "./tokprev/icon": "./icon.svg",
    "./promptopt/icon": "./icon.svg",
    "./tokprev/locale/*.json": "./locale/tokprev/*.json",
    "./promptopt/locale/*.json": "./locale/promptopt/*.json",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.3": "compatible"
      }
    }
  },
  "files": [
    "lib",
    "locale",
    "screenshots.json",
    "docs/assets/tokstats.png",
    "docs/assets/tokstats-en.png",
    "docs/assets/tokprev.png",
    "docs/assets/tokprev-en.png",
    "docs/assets/promptopt.png",
    "docs/assets/promptopt-en.png",
    "icon.svg",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "AGENTS.md",
    "docs/MAINTAINING.md",
    "docs/INVARIANTS.md"
  ],
  "license": "MIT"
}

